# Настройки SEO-панели. Скопируйте в файл вне репозитория (например /etc/seo-panel.env),
# права 600, владелец — пользователь службы. Настоящие значения в git не кладите.

# Случайная строка не короче 32 символов:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PANEL_SECRET_KEY=

# Хэш пароля для входа:  python -m app.hashpw
PANEL_PASSWORD_HASH=

# Публичный адрес панели, как его видит браузер (без завершающего /).
PANEL_BASE_URL=https://example.com/panel

# Где хранить базу (токены доступа и кэш). Каталог должен быть доступен только службе.
PANEL_DATA_DIR=/var/lib/seo-panel

# 1 — если панель стоит за nginx на той же машине (нужно для ограничения попыток входа по IP).
PANEL_TRUST_PROXY=1

# Как часто обновлять данные, в часах.
PANEL_REFRESH_HOURS=6

# Приложение Google (Google Cloud Console → Credentials → OAuth client ID, тип Web application).
# Redirect URI: <PANEL_BASE_URL>/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Приложение Яндекса (oauth.yandex.ru). Redirect URI: <PANEL_BASE_URL>/connect/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Необязательно: отдельный токен для API Вордстата, если доступ к нему выдан другому приложению.
WORDSTAT_TOKEN=
